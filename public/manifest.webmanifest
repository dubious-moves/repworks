{
  "id": "/repworks/",
  "name": "Repworks",
  "short_name": "Repworks",
  "description": "Chess studies, repertoire training and review.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#161a17",
  "theme_color": "#22412e",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Train",
      "short_name": "Train",
      "description": "Today's repertoire moves",
      "url": "./#/train",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Storm",
      "short_name": "Storm",
      "description": "The intuition storm",
      "url": "./#/storm",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Games",
      "short_name": "Games",
      "description": "Your games and their cards",
      "url": "./#/games",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Endgames",
      "short_name": "Endgames",
      "description": "The endgames, each played for its goal",
      "url": "./#/endgames",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "pgn",
          "accept": [
            ".pgn",
            "application/x-chess-pgn",
            "application/vnd.chess-pgn",
            "text/plain"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-chess-pgn": [
          ".pgn"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
